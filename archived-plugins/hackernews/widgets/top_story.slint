export component TopStory inherits Rectangle {
    in property <string> title: "";
    in property <int> score: 0;
    in property <string> error: "";

    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Text { text: "HACKER NEWS"; font-size: 10px; opacity: 0.5; }
        Text {
            text: root.error != "" ? root.error : root.title;
            wrap: word-wrap;
            overflow: elide;
        }
        Text { text: root.score + " points"; font-size: 11px; opacity: 0.6; }
    }
}
