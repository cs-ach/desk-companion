export component DaysLeft inherits Rectangle {
    in property <string> label: "";
    in property <int> days: 0;

    VerticalLayout {
        alignment: center;
        Text { text: root.days; font-size: 32px; horizontal-alignment: center; }
        Text { text: root.label; font-size: 12px; horizontal-alignment: center; }
    }
}
