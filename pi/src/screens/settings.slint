import { Tokens } from "tokens.slint";
import { Surface } from "glass.slint";
import { Icon } from "icon.slint";
import { Switch, SegmentedPair, Row, Separator } from "controls.slint";

component Swatch inherits Rectangle {
    in property <brush> preview;
    in property <bool> selected;
    callback clicked();

    width: 46px;
    border-radius: 11px;
    border-width: root.selected ? 2px : 1px;
    background: root.preview;
    border-color: root.selected ? Tokens.control : #ffffff24;
    opacity: touch.pressed ? 0.7 : 1.0;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export struct WallpaperOption {
    id: string,
    thumb: image,
}

export struct SettingsPlugin {
    id: string,
    name: string,
    status: string,
    running: bool,
    can_authorize: bool,
}

component GroupHeader inherits Text {
    font-family: Tokens.face;
    font-size: Tokens.caption_size;
    font-weight: 600;
    color: Tokens.text_3;
}

export component Settings inherits Rectangle {
    in property <bool> dock_right;
    in property <string> background_name;
    in property <[WallpaperOption]> wallpapers;
    in property <[SettingsPlugin]> plugins;
    in property <string> device_line;
    callback dock_side(bool);
    callback background_picked(string);
    callback transparency(bool);
    callback connect_plugin(string);
    callback refresh_wallpapers();

    x: Tokens.content_x;
    y: Tokens.slot_y;
    width: Tokens.content_w;
    height: Tokens.slot_h;

    HorizontalLayout {
        spacing: Tokens.gap;

        Surface {
            border-radius: Tokens.r_group;
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 20px;
                spacing: 0px;

                GroupHeader { text: "Appearance"; }

                Rectangle { height: 14px; }

                Row {
                    label: "Dock position";
                    SegmentedPair {
                        first: "Left";
                        second: "Right";
                        second_selected: root.dock_right;
                        picked(right) => { root.dock_side(right); }
                    }
                }

                Separator { }

                Row {
                    label: "Background";
                    row_height: 64px;

                    HorizontalLayout {
                        spacing: 9px;
                        alignment: end;

                        Swatch {
                            preview: Tokens.bg_tide;
                            selected: root.background_name == "tide";
                            clicked => { root.background_picked("tide"); }
                        }
                        Swatch {
                            preview: Tokens.bg_violet;
                            selected: root.background_name == "violet";
                            clicked => { root.background_picked("violet"); }
                        }
                        Swatch {
                            preview: Tokens.bg_ember;
                            selected: root.background_name == "ember";
                            clicked => { root.background_picked("ember"); }
                        }
                        Swatch {
                            preview: Tokens.bg_mono;
                            selected: root.background_name == "mono";
                            clicked => { root.background_picked("mono"); }
                        }
                    }
                }

                if root.wallpapers.length > 0: Separator { }

                if root.wallpapers.length > 0: Row {
                    label: "Wallpaper";
                    row_height: 64px;

                    HorizontalLayout {

                    TouchArea {
                        width: 32px;
                        height: 32px;
                        clicked => { root.refresh_wallpapers(); }

                        Path {
                            width: 24px;
                            height: 24px;
                            stroke-width: 2px;
                            
                            commands: "M 23 4 L 23 10 L 17 10 M 20.49 15 A 9 9 0 1 1 21.21 8 L 23 10";
                        }
                    }

                        spacing: 9px;
                        alignment: end;

                        for w[i] in root.wallpapers: Rectangle {
                            width: 76px;
                            height: 44px;
                            border-radius: 11px;
                            border-width: root.background_name == w.id ? 2px : 1px;
                            border-color: root.background_name == w.id
                                ? Tokens.control
                                : #ffffff24;
                            clip: true;

                            Image {
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                                source: w.thumb;
                            }

                            TouchArea {
                                clicked => { root.background_picked(w.id); }
                            }
                        }
                    }
                }
            }
        }

        Surface {
            width: 286px;
            border-radius: Tokens.r_group;

            VerticalLayout {
                padding: 20px;
                spacing: 0px;

                GroupHeader { text: "Plugins"; }

                Rectangle { height: 10px; }

                for p[i] in root.plugins: HorizontalLayout {
                    height: 56px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 10px;
                            border-width: 1px;
                            background: #ffffff1a;
                            border-color: #ffffff1a;

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 17px;
                                height: 17px;
                                kind: "plugin";
                                tint: Tokens.text_2;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;

                        Text {
                            text: p.name;
                            font-family: Tokens.face;
                            font-size: Tokens.body_size;
                            font-weight: 600;
                            color: Tokens.text;
                            overflow: elide;
                        }

                        Text {
                            text: p.status;
                            font-family: Tokens.face;
                            font-size: Tokens.label_size;
                            font-weight: 500;
                            color: p.running ? Tokens.text_3 : Tokens.caution;
                            overflow: elide;
                        }
                    }

                    if p.can_authorize: VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 84px;
                            height: 34px;
                            border-radius: 11px;
                            background: connect.pressed ? #0A84FFcc : Tokens.control;

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "Connect";
                                font-family: Tokens.face;
                                font-size: Tokens.caption_size;
                                font-weight: 600;
                                color: Tokens.text;
                            }

                            connect := TouchArea {
                                clicked => { root.connect_plugin(p.id); }
                            }
                        }
                    }
                }

                if root.plugins.length == 0: Text {
                    text: "No plugins installed";
                    font-family: Tokens.face;
                    font-size: Tokens.caption_size;
                    font-weight: 500;
                    color: Tokens.text_3;
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
