export component Icon inherits Rectangle {
    in property <string> kind;
    in property <brush> tint: #ffffff;
    in property <length> stroke: 1.8px;

    property <string> commands:
        root.kind == "grid" ? "M 5.7 3.5 L 8.3 3.5 A 2.2 2.2 0 0 1 10.5 5.7 L 10.5 8.3 A 2.2 2.2 0 0 1 8.3 10.5 L 5.7 10.5 A 2.2 2.2 0 0 1 3.5 8.3 L 3.5 5.7 A 2.2 2.2 0 0 1 5.7 3.5 Z M 15.7 3.5 L 18.3 3.5 A 2.2 2.2 0 0 1 20.5 5.7 L 20.5 8.3 A 2.2 2.2 0 0 1 18.3 10.5 L 15.7 10.5 A 2.2 2.2 0 0 1 13.5 8.3 L 13.5 5.7 A 2.2 2.2 0 0 1 15.7 3.5 Z M 5.7 13.5 L 8.3 13.5 A 2.2 2.2 0 0 1 10.5 15.7 L 10.5 18.3 A 2.2 2.2 0 0 1 8.3 20.5 L 5.7 20.5 A 2.2 2.2 0 0 1 3.5 18.3 L 3.5 15.7 A 2.2 2.2 0 0 1 5.7 13.5 Z M 15.7 13.5 L 18.3 13.5 A 2.2 2.2 0 0 1 20.5 15.7 L 20.5 18.3 A 2.2 2.2 0 0 1 18.3 20.5 L 15.7 20.5 A 2.2 2.2 0 0 1 13.5 18.3 L 13.5 15.7 A 2.2 2.2 0 0 1 15.7 13.5 Z"
      :         root.kind == "wave" ? "M 2.5 12 L 5.5 12 L 8 5 L 11.5 19 L 14.5 10 L 16.5 15 L 21.5 15"
      :         root.kind == "chat" ? "M 20.5 15 A 2.5 2.5 0 0 1 18 17.5 L 8.5 17.5 L 4 21 L 4 5.5 A 2.5 2.5 0 0 1 6.5 3 L 17.5 3 A 2.5 2.5 0 0 1 20 5.5 Z"
      :         root.kind == "globe" ? "M 12 3.25 A 8.75 8.75 0 0 1 12 20.75 A 8.75 8.75 0 0 1 12 3.25 Z M 3.25 12 L 20.75 12 M 12 3.25 C 14.4 5.85 15.7 8.8 15.7 12 C 15.7 15.2 14.4 18.15 12 20.75 C 9.6 18.15 8.3 15.2 8.3 12 C 8.3 8.8 9.6 5.85 12 3.25 Z"
      :         root.kind == "gear" ? "M 12 8.9 A 3.1 3.1 0 0 1 12 15.1 A 3.1 3.1 0 0 1 12 8.9 Z M 10.5 2.6 L 13.5 2.6 L 13.9 5.1 L 15.9 5.9 L 17.9 4.4 L 20 6.5 L 18.5 8.5 L 19.3 10.5 L 21.8 10.9 L 21.8 13.9 L 19.3 14.3 L 18.5 16.3 L 20 18.3 L 17.9 20.4 L 15.9 18.9 L 13.9 19.7 L 13.5 22.2 L 10.5 22.2 L 10.1 19.7 L 8.1 18.9 L 6.1 20.4 L 4 18.3 L 5.5 16.3 L 4.7 14.3 L 2.2 13.9 L 2.2 10.9 L 4.7 10.5 L 5.5 8.5 L 4 6.5 L 6.1 4.4 L 8.1 5.9 L 10.1 5.1 Z"
      :         root.kind == "sliders" ? "M 4 7.5 L 12.5 7.5 M 19 7.5 L 20 7.5 M 4 16.5 L 5 16.5 M 11.5 16.5 L 20 16.5 M 15.5 5.1 A 2.4 2.4 0 0 1 15.5 9.9 A 2.4 2.4 0 0 1 15.5 5.1 Z M 8 14.1 A 2.4 2.4 0 0 1 8 18.9 A 2.4 2.4 0 0 1 8 14.1 Z"
      :         root.kind == "alert" ? "M 12 3 A 9 9 0 0 1 12 21 A 9 9 0 0 1 12 3 Z M 12 7.5 L 12 13 M 12 16.6 L 12 16.9"
      :         root.kind == "back" ? "M 14.5 5 L 7.5 12 L 14.5 19"
      :         root.kind == "home" ? "M 3.5 10.2 L 12 3.4 L 20.5 10.2 L 20.5 19 A 1.6 1.6 0 0 1 18.9 20.6 L 5.1 20.6 A 1.6 1.6 0 0 1 3.5 19 Z"
      :         root.kind == "apps" ? "M 10 3.5 L 19 3.5 A 2 2 0 0 1 21 5.5 L 21 14.5 A 2 2 0 0 1 19 16.5 L 10 16.5 A 2 2 0 0 1 8 14.5 L 8 5.5 A 2 2 0 0 1 10 3.5 Z M 4.5 7.6 L 4.5 18.5 A 2 2 0 0 0 6.5 20.5 L 16.4 20.5"
      :         root.kind == "clock" ? "M 12 3.25 A 8.75 8.75 0 0 1 12 20.75 A 8.75 8.75 0 0 1 12 3.25 Z M 12 7.1 L 12 12.4 L 15.7 14.5"
      :         root.kind == "plugin" ? "M 12 3.2 L 19.8 7.6 L 19.8 16.4 L 12 20.8 L 4.2 16.4 L 4.2 7.6 Z"
      : "";

    width: 21px;
    height: 21px;

    if root.commands != "": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.commands;
        stroke: root.tint; stroke-width: root.stroke; fill: transparent;
    }
}
