import { Tokens } from "tokens.slint";
import { Icon } from "icon.slint";
import { Pill, Dot } from "glass.slint";

export component StatusBar inherits Rectangle {
    in property <string> lead;
    in property <bool> show_back;
    in property <bool> linked;
    in property <string> clock;
    callback back();

    x: Tokens.content_x;
    y: Tokens.edge;
    width: Tokens.content_w;
    height: Tokens.status_h;

    if root.show_back: Rectangle {
        x: 0px;
        width: 30px;
        height: 30px;
        border-radius: 10px;
        border-width: 1px;
        background: #ffffff1a;
        border-color: #ffffff1a;

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            kind: "back";
            tint: Tokens.control;
            stroke: 2.2px;
        }

        TouchArea {
            clicked => { root.back(); }
        }
    }

    Text {
        x: root.show_back ? 40px : 0px;
        y: (parent.height - self.height) / 2;
        text: root.lead;
        font-family: Tokens.face;
        font-size: root.show_back ? Tokens.headline_size : Tokens.body_size;
        font-weight: root.show_back ? 700 : 600;
        color: Tokens.text;
    }

    // One pill, always in the same place on every page: the dot is the link to
    // the host and the numerals are the clock. The plugin count used to live
    // here, which spent the most valuable corner of the screen on something
    // nobody reads twice.
    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: end;

        Pill {
            HorizontalLayout {
                padding-left: 13px;
                padding-right: 13px;
                spacing: 8px;
                alignment: center;

                Dot {
                    fill: root.linked ? Tokens.ok : Tokens.alert;
                }

                Text {
                    text: root.clock;
                    font-family: Tokens.face;
                    font-size: Tokens.caption_size;
                    font-weight: 600;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
            }
        }
    }
}
