import { Tokens } from "tokens.slint";

// Settings controls. The shell owns these so every plugin's settings look the
// same; a plugin picks a control, never draws one.

export component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);

    width: 51px;
    height: 31px;
    border-radius: self.height / 2;
    border-width: 1px;
    background: root.on ? Tokens.ok : #ffffff24;
    border-color: root.on ? Tokens.ok : #ffffff24;
    opacity: touch.pressed ? 0.78 : 1.0;

    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 25px;
        height: 25px;
        border-radius: self.height / 2;
        background: #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000059;
        drop-shadow-offset-y: 1px;

        animate x { duration: 160ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.toggled(!root.on); }
    }
}

component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    border-radius: Tokens.r_nested - 3px;
    background: root.selected ? #ffffffeb : (touch.pressed ? #ffffff14 : transparent);

    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        font-family: Tokens.face;
        font-size: 14px;
        font-weight: 600;
        // Dark ink on the selected pill: white-on-white would vanish, and a
        // tinted pill would read as a second accent.
        color: root.selected ? #10131A : Tokens.text_2;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SegmentedPair inherits Rectangle {
    in property <string> first;
    in property <string> second;
    in property <bool> second_selected;
    callback picked(bool);

    width: 152px;
    height: 38px;
    border-radius: Tokens.r_nested;
    border-width: 1px;
    background: #ffffff1f;
    border-color: #ffffff1a;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;

        Segment {
            label: root.first;
            selected: !root.second_selected;
            clicked => { root.picked(false); }
        }

        Segment {
            label: root.second;
            selected: root.second_selected;
            clicked => { root.picked(true); }
        }
    }
}

// One row of a settings group: a label, an optional second line, and whatever
// control the caller puts in it.
export component Row inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <length> row_height: 56px;

    height: root.row_height;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                font-family: Tokens.face;
                font-size: Tokens.body_size;
                font-weight: 500;
                color: Tokens.text;
                overflow: elide;
            }

            if root.detail != "": Text {
                text: root.detail;
                font-family: Tokens.face;
                font-size: Tokens.label_size;
                font-weight: 500;
                color: Tokens.text_3;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

export component Separator inherits Rectangle {
    height: 1px;
    background: Tokens.separator;
}
