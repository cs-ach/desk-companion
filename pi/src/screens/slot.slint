import { Tokens } from "tokens.slint";
import { Icon } from "icon.slint";
import { Surface } from "glass.slint";

export struct Slot {
    id: string,
    title: string,
    glyph: string,
    col: int,
    row: int,
    cols: int,
    rows: int,
    state: string,
    value: string,
    unit: string,
    headline: string,
    detail: string,
    meta: string,
    tint: color,
    accent: color,
    focused: bool,
}

component Skeleton inherits Rectangle {
    in property <length> bar_height: 11px;
    height: root.bar_height;
    border-radius: root.bar_height / 2;
    background: #ffffff1a;
}

component StaleChip inherits Rectangle {
    width: 52px;
    height: 20px;
    border-radius: 7px;
    background: #FF9F0A2e;

    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: "Stale";
        font-family: Tokens.face;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.caution;
    }
}

export component SlotView inherits Rectangle {
    in property <Slot> slot;
    callback clicked();

    clip: true;

    property <bool> compact: root.width < 200px;
    property <bool> dim: root.slot.state == "stale";
    property <bool> has_data: root.slot.state == "ready" || root.slot.state == "stale";
    property <length> value_size: root.height > 300px ? 64px : Tokens.display_size;

    // An empty slot is drawn as an outline rather than a filled pane: nothing
    // is there yet, so it should not claim the visual weight of a pane that
    // has content.
    if root.slot.state != "empty": Surface {
        width: 100%;
        height: 100%;
        focused: root.slot.focused;
        tint: root.slot.state == "ready" ? root.slot.tint : transparent;
    }

    if root.slot.state == "empty": Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Tokens.r_panel;
        border-width: 1px;
        border-color: #ffffff29;
        background: transparent;
    }

    VerticalLayout {
        padding: 20px;
        spacing: 0px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            if root.slot.state == "error": VerticalLayout {
                alignment: center;

                Icon {
                    width: 16px;
                    height: 16px;
                    kind: "alert";
                    tint: Tokens.alert;
                    stroke: 2.1px;
                }
            }

            Text {
                text: root.slot.title;
                font-family: Tokens.face;
                font-size: Tokens.caption_size;
                font-weight: 600;
                color: root.slot.state == "error" ? Tokens.alert : Tokens.text_3;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.slot.state == "stale": StaleChip { }

            if root.slot.state == "ready" && root.slot.meta != "": Text {
                text: root.slot.meta;
                font-family: Tokens.face;
                font-size: Tokens.label_size;
                font-weight: 500;
                color: Tokens.text_3;
                vertical-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        if root.has_data && !root.compact: VerticalLayout {
            spacing: 0px;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                Text {
                    text: root.slot.value;
                    font-family: Tokens.face;
                    font-size: root.value_size;
                    font-weight: 700;
                    letter-spacing: -2px;
                    color: root.dim ? Tokens.text_3 : Tokens.text;
                }

                if root.slot.unit != "": VerticalLayout {
                    alignment: start;
                    padding-top: root.value_size * 0.14;

                    Text {
                        text: root.slot.unit;
                        font-family: Tokens.face;
                        font-size: 19px;
                        font-weight: 600;
                        color: Tokens.text_2;
                    }
                }
            }

            if root.slot.headline != "": Text {
                text: root.slot.headline;
                font-family: Tokens.face;
                font-size: Tokens.title_size;
                font-weight: 700;
                letter-spacing: -0.4px;
                color: root.dim ? Tokens.text_2 : Tokens.text;
                wrap: word-wrap;
            }

            if root.slot.detail != "": Text {
                text: root.slot.detail;
                font-family: Tokens.face;
                font-size: Tokens.caption_size;
                font-weight: 500;
                color: Tokens.text_2;
                wrap: word-wrap;
            }
        }

        if root.has_data && root.compact: VerticalLayout {
            spacing: 3px;

            Text {
                text: root.slot.headline;
                font-family: Tokens.face;
                font-size: Tokens.headline_size;
                font-weight: 700;
                letter-spacing: -0.3px;
                color: root.dim ? Tokens.text_2 : Tokens.text;
                overflow: elide;
            }

            Text {
                text: root.slot.detail;
                font-family: Tokens.face;
                font-size: Tokens.caption_size;
                font-weight: 500;
                color: Tokens.text_3;
                overflow: elide;
            }
        }

        if root.slot.state == "empty": Text {
            text: "Waiting for data";
            font-family: Tokens.face;
            font-size: Tokens.caption_size;
            font-weight: 500;
            color: Tokens.text_3;
        }

        if root.slot.state == "loading": VerticalLayout {
            spacing: 9px;
            Skeleton { bar_height: 24px; width: 62%; }
            Skeleton { }
            Skeleton { width: 74%; }
        }

        if root.slot.state == "error": VerticalLayout {
            spacing: 3px;

            Text {
                text: "Unavailable";
                font-family: Tokens.face;
                font-size: root.compact ? Tokens.headline_size : Tokens.title_size;
                font-weight: 700;
                letter-spacing: -0.4px;
                color: Tokens.text;
            }

            Text {
                text: "Tap for detail";
                font-family: Tokens.face;
                font-size: Tokens.caption_size;
                font-weight: 500;
                color: Tokens.text_2;
            }
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}
